# eBay API Credentials
# Get keys at https://developer.ebay.com/my/keys
EBAY_APP_ID=your_client_id_here
EBAY_CERT_ID=your_client_secret_here
EBAY_DEV_ID=your_dev_id_here
EBAY_REDIRECT_URI=your_runame_here
EBAY_USER_TOKEN=your_oauth_token_here
EBAY_SANDBOX=true

# eBay Login (for eBay bidding + Goldin SSO via "Sign in with eBay")
EBAY_LOGIN_EMAIL=
EBAY_LOGIN_PASSWORD=

# CardLadder API
# Subscribe at https://cardladder.com
CARDLADDER_API_KEY=your_cardladder_key_here

# PSA API
# Register at https://www.psacard.com/publicapi
PSA_API_KEY=your_psa_key_here

# Anthropic API (for smart card title parsing)
# Get key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Fanatics Collect (for autobidder)
# Create account at https://www.fanaticscollect.com
FANATICS_EMAIL=
FANATICS_PASSWORD=

# Goldin Auctions (for autobidder)
# Uses eBay SSO by default (EBAY_LOGIN_EMAIL above)
# Or set these for a direct Goldin account:
GOLDIN_EMAIL=
GOLDIN_PASSWORD=

# Autobidder Settings
AUTOBID_HARD_CAP=5000.00
AUTOBID_POLL_INTERVAL=60

# Agent Settings
AGENT_AUTO_BUY_LIMIT=50.00
AGENT_MAX_PORTFOLIO_VALUE=5000.00
AGENT_MAX_SINGLE_CARD=500.00
AGENT_MIN_PROFIT_MARGIN=0.15
AGENT_SCAN_INTERVAL_MINUTES=30

# Notifications (optional)
NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
